# 可选。不设置时程序使用 YouTube 网页 Innertube，不需要密钥。
# YOUTUBE_API_KEY=
# USE_OFFICIAL_API=false

# 日志级别 DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# 性能参数
NUM_WORKERS=6
MAX_VIDEOS_PER_REGION=20
REQUEST_TIMEOUT=20
MAX_RETRIES=3
RETRY_DELAY=5
REQUEST_DELAY=2

# 代理池（逗号分隔）。留空则直连。
# PROXIES=http://proxy1.example.com:8080,http://proxy2.example.com:8080
# USE_PROXY_ROTATION=false
# PROXY_API_URL=
# PROXY_API_KEY=
